/* ── Main window ── */
.main-window {
    background-color: #0D0D0D;
    flex-grow: 1;
    flex-direction: column;
}

/* ── Header ── */
.header-row {
    background-color: #1F1F1F;
    border-bottom-width: 1px;
    border-bottom-color: #333333;
    flex-direction: row;
    height: 46px;
    align-items: center;
    padding-left: 16px;
    padding-right: 16px;
    flex-shrink: 0;
}

/* ── Header group (horizontal container) ── */
.header-group {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.header-label {
    color: #E6E6E6;
    font-size: 14px;
    min-width: 48px;
    margin-right: 8px;
}

.room-name-edit {
    background-color: rgba(0, 0, 0, 0);
    color: #FFFFFF;
    border-width: 0px;
    font-size: 14px;
    -unity-font-style: bold;
    max-width: 200px;
    flex-grow: 1;
    padding-top: 4px;
    padding-bottom: 4px;
}

.room-name-edit > .unity-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    color: #FFFFFF;
    border-width: 0px;
    font-size: 14px;
    -unity-font-style: bold;
    padding-left: 0px;
    padding-right: 0px;
}

.room-name-edit:focus > .unity-text-field__input {
    border-bottom-width: 1px;
    border-bottom-color: #555555;
}

.header-spacer {
    flex-grow: 1;
}

/* ── Public toggle (Button-based) ── */
.public-label {
    color: #E6E6E6;
    font-size: 14px;
    margin-right: 6px;
    flex-shrink: 0;
}

.public-toggle {
    color: #FFFFFF;
    font-size: 16px;
    border-width: 1px;
    border-color: #666666;
    background-color: #1A1A1A;
    border-radius: 3px;
    width: 24px;
    height: 24px;
    margin-right: 8px;
    flex-shrink: 0;
    padding: 0px;
}

.public-toggle:hover {
    border-color: #888888;
}

.public-toggle-on {
    color: #4CAF50;
    border-color: #4CAF50;
    background-color: rgba(76, 175, 80, 0.15);
}

.public-toggle-off {
    color: #555555;
    border-color: #444444;
    background-color: #1A1A1A;
}

/* ── Password field ── */
.password-label {
    color: #888888;
    font-size: 13px;
    margin-left: 12px;
    margin-right: 4px;
    flex-shrink: 0;
}

.password-field {
    background-color: #1A1A1A;
    color: #E6E6E6;
    border-width: 1px;
    border-color: #444444;
    border-radius: 3px;
    font-size: 13px;
    width: 180px;
    max-width: 180px;
    min-width: 180px;
    height: 32px;
    padding-left: 6px;
    padding-right: 6px;
    flex-shrink: 0;
}

.password-field > .unity-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    color: #E6E6E6;
    border-width: 0px;
    font-size: 13px;
    padding-left: 0px;
    padding-right: 0px;
}

.password-field:focus {
    border-color: #777777;
}

/* ── Content row ── */
.content-row {
    flex-direction: row;
    flex-grow: 1;
}

/* ── Left panel ── */
.left-panel {
    width: 42%;
    flex-shrink: 0;
    flex-direction: column;
    border-right-width: 1px;
    border-right-color: #2A2A2A;
}

.left-scroll {
    flex-grow: 1;
}

/* Hide scrollbar visual but keep scrolling */
.left-scroll > .unity-scroll-view__vertical-scroller {
    width: 0px;
    visibility: hidden;
}

.left-content {
    flex-direction: column;
    flex-shrink: 0;
}

/* ── Map preview ── */
.map-preview {
    height: 160px;
    background-color: #1A2A1A;
    border-bottom-width: 1px;
    border-bottom-color: #2A2A2A;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.map-preview-placeholder {
    color: #555555;
    font-size: 14px;
    -unity-font-style: italic;
}

/* ── Settings container ── */
.settings-container {
    flex-direction: column;
    flex-shrink: 0;
}

/* ── Room visibility group (public/password in settings) ── */
.room-visibility-group {
    background-color: #1A1A1A;
    border-bottom-width: 1px;
    border-bottom-color: #2A2A2A;
    height: 44px;
    padding-left: 16px;
    padding-right: 16px;
}

/* ── Setting row ── */
.setting-row {
    background-color: #1A1A1A;
    border-bottom-width: 1px;
    border-bottom-color: #2A2A2A;
    flex-direction: row;
    height: 40px;
    align-items: center;
    padding-left: 16px;
    padding-right: 16px;
    flex-shrink: 0;
}

.setting-row:hover {
    background-color: #252525;
}

.row-label {
    color: #E6E6E6;
    font-size: 13px;
    flex-grow: 1;
}

.control-area {
    flex-direction: row;
    align-items: center;
}

.arrow-btn {
    background-color: rgba(0, 0, 0, 0);
    color: #888888;
    border-width: 0px;
    font-size: 12px;
    width: 30px;
    height: 30px;
    flex-shrink: 0;
}

.arrow-btn:hover {
    color: #FFFFFF;
}

.arrow-btn:active {
    color: #AAAAAA;
}

.row-value {
    color: #FFFFFF;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    min-width: 130px;
    text-align: center;
    flex-shrink: 0;
}

/* ── Map description ── */
.map-desc-section {
    background-color: #111111;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 16px;
    padding-right: 16px;
    flex-shrink: 0;
}

.map-desc-title {
    color: #888888;
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.map-desc-text {
    color: #BBBBBB;
    font-size: 12px;
    white-space: normal;
}

/* ── Right panel ── */
.right-panel {
    flex-grow: 1;
    flex-direction: column;
}

/* ── Teams container ── */
.teams-container {
    flex-direction: row;
    flex-grow: 1;
}

/* ── Team column ── */
.team-column {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
    border-right-width: 1px;
    border-right-color: #2A2A2A;
}

.team-blue {
    border-right-width: 0px;
}

/* ── Team header ── */
.team-header {
    flex-direction: row;
    align-items: center;
    height: 40px;
    padding-left: 16px;
    padding-right: 16px;
    flex-shrink: 0;
}

.team-header-red {
    background-color: #2A0E0E;
    border-bottom-width: 2px;
    border-bottom-color: #8B2020;
}

.team-header-blue {
    background-color: #0E1A2A;
    border-bottom-width: 2px;
    border-bottom-color: #2050A0;
}

.team-name {
    font-size: 14px;
    -unity-font-style: bold;
    flex-grow: 1;
}

.team-header-red .team-name {
    color: #FF6B6B;
}

.team-header-blue .team-name {
    color: #6B9EFF;
}

.team-count {
    font-size: 13px;
    color: #888888;
}

/* ── Player scroll ── */
.player-scroll {
    flex-grow: 1;
}

.player-scroll > .unity-scroll-view__vertical-scroller {
    width: 0px;
    visibility: hidden;
}

.player-list {
    flex-direction: column;
    flex-shrink: 0;
}

/* ── Slot (shared) ── */
.slot {
    flex-direction: row;
    align-items: center;
    height: 44px;
    padding-left: 16px;
    padding-right: 16px;
    border-bottom-width: 1px;
    border-bottom-color: #1F1F1F;
    flex-shrink: 0;
}

.slot-index {
    color: #555555;
    font-size: 11px;
    width: 28px;
    flex-shrink: 0;
}

/* ── Empty slot (clickable) ── */
.slot-empty {
    background-color: #111111;
}

.slot-empty:hover {
    background-color: #1E1E1E;
}

.slot-empty:hover .slot-empty-hint {
    color: #AAAAAA;
}

.team-red .slot-empty:hover {
    border-left-width: 2px;
    border-left-color: #8B2020;
    padding-left: 14px;
}

.team-blue .slot-empty:hover {
    border-right-width: 2px;
    border-right-color: #2050A0;
    padding-right: 14px;
}

.slot-empty-hint {
    color: #444444;
    font-size: 12px;
    flex-grow: 1;
}

/* ── Occupied slot ── */
.slot-occupied {
    background-color: #1A1A1A;
}

.slot-occupied:hover {
    background-color: #222222;
}

/* ── Local player highlight ── */
.slot-local {
    background-color: #1C2618;
    border-left-width: 3px;
    border-left-color: #4CAF50;
    padding-left: 13px;
}

.slot-local:hover {
    background-color: #233020;
}

/* ── Player info ── */
.player-name {
    color: #E6E6E6;
    font-size: 13px;
    flex-grow: 1;
}

.player-status {
    font-size: 12px;
    -unity-font-style: bold;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 2px;
    padding-bottom: 2px;
}

.player-status-ready {
    color: #4CAF50;
    background-color: rgba(76, 175, 80, 0.12);
    border-radius: 3px;
}

.player-status-not-ready {
    color: #FF9800;
    background-color: rgba(255, 152, 0, 0.12);
    border-radius: 3px;
}

/* ── Action bar ── */
.action-bar {
    background-color: #1F1F1F;
    border-top-width: 1px;
    border-top-color: #333333;
    flex-direction: row;
    height: 54px;
    align-items: center;
    padding-left: 16px;
    padding-right: 16px;
    flex-shrink: 0;
}

.action-hint {
    color: #777777;
    font-size: 12px;
}

.action-spacer {
    flex-grow: 1;
}

.ready-btn {
    color: #FFFFFF;
    font-size: 14px;
    -unity-font-style: bold;
    background-color: #2E7D32;
    border-width: 0px;
    border-radius: 4px;
    height: 36px;
    padding-left: 32px;
    padding-right: 32px;
    flex-shrink: 0;
}

.ready-btn:hover {
    background-color: #388E3C;
}

.ready-btn:active {
    background-color: #1B5E20;
}

.cancel-btn {
    color: #FFFFFF;
    font-size: 14px;
    -unity-font-style: bold;
    background-color: #E65100;
    border-width: 0px;
    border-radius: 4px;
    height: 36px;
    padding-left: 24px;
    padding-right: 24px;
    flex-shrink: 0;
    margin-left: 8px;
}

.cancel-btn:hover {
    background-color: #F57C00;
}

.cancel-btn:active {
    background-color: #BF360C;
}

.start-btn {
    color: #FFFFFF;
    font-size: 14px;
    -unity-font-style: bold;
    background-color: #1565C0;
    border-width: 0px;
    border-radius: 4px;
    height: 36px;
    padding-left: 24px;
    padding-right: 24px;
    flex-shrink: 0;
    margin-left: 8px;
}

.start-btn:hover {
    background-color: #1976D2;
}

.start-btn:active {
    background-color: #0D47A1;
}
