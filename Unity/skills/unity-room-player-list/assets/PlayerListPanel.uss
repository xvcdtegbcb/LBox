/* ── Main window ── */
.main-window {
    background-color: #0D0D0D;
    flex-grow: 1;
    flex-direction: column;
}

/* ── Header ── */
.header-row {
    background-color: #1F1F1F;
    border-bottom-width: 1px;
    border-bottom-color: #333333;
    flex-direction: row;
    height: 46px;
    align-items: center;
    padding-left: 16px;
    padding-right: 16px;
    flex-shrink: 0;
}

.header-title {
    color: #E6E6E6;
    font-size: 15px;
    -unity-font-style: bold;
}

.header-spacer {
    flex-grow: 1;
}

.header-count {
    color: #888888;
    font-size: 13px;
}

/* ── Teams container ── */
.teams-container {
    flex-direction: row;
    flex-grow: 1;
}

/* ── Team column ── */
.team-column {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
    border-right-width: 1px;
    border-right-color: #2A2A2A;
}

.team-blue {
    border-right-width: 0px;
}

/* ── Team header ── */
.team-header {
    flex-direction: row;
    align-items: center;
    height: 40px;
    padding-left: 16px;
    padding-right: 16px;
    flex-shrink: 0;
}

.team-header-red {
    background-color: #2A0E0E;
    border-bottom-width: 2px;
    border-bottom-color: #8B2020;
}

.team-header-blue {
    background-color: #0E1A2A;
    border-bottom-width: 2px;
    border-bottom-color: #2050A0;
}

.team-name {
    font-size: 14px;
    -unity-font-style: bold;
    flex-grow: 1;
}

.team-header-red .team-name {
    color: #FF6B6B;
}

.team-header-blue .team-name {
    color: #6B9EFF;
}

.team-count {
    font-size: 13px;
    color: #888888;
}

/* ── Player scroll ── */
.player-scroll {
    flex-grow: 1;
}

.player-list {
    flex-direction: column;
    flex-shrink: 0;
}

/* ── Slot (shared) ── */
.slot {
    flex-direction: row;
    align-items: center;
    height: 44px;
    padding-left: 16px;
    padding-right: 16px;
    border-bottom-width: 1px;
    border-bottom-color: #1F1F1F;
    flex-shrink: 0;
}

.slot-index {
    color: #555555;
    font-size: 11px;
    width: 28px;
    flex-shrink: 0;
}

/* ── Empty slot (clickable) ── */
.slot-empty {
    background-color: #111111;
}

.slot-empty:hover {
    background-color: #1E1E1E;
}

.slot-empty:hover .slot-empty-hint {
    color: #AAAAAA;
}

.team-red .slot-empty:hover {
    border-left-width: 2px;
    border-left-color: #8B2020;
    padding-left: 14px;
}

.team-blue .slot-empty:hover {
    border-right-width: 2px;
    border-right-color: #2050A0;
    padding-right: 14px;
}

.slot-empty-hint {
    color: #444444;
    font-size: 12px;
    flex-grow: 1;
}

/* ── Occupied slot ── */
.slot-occupied {
    background-color: #1A1A1A;
}

.slot-occupied:hover {
    background-color: #222222;
}

/* ── Local player highlight ── */
.slot-local {
    background-color: #1C2618;
    border-left-width: 3px;
    border-left-color: #4CAF50;
    padding-left: 13px;
}

.slot-local:hover {
    background-color: #233020;
}

/* ── Player info ── */
.player-name {
    color: #E6E6E6;
    font-size: 13px;
    flex-grow: 1;
}

.player-status {
    font-size: 12px;
    -unity-font-style: bold;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 2px;
    padding-bottom: 2px;
}

.player-status-ready {
    color: #4CAF50;
    background-color: rgba(76, 175, 80, 0.12);
    border-radius: 3px;
}

.player-status-not-ready {
    color: #FF9800;
    background-color: rgba(255, 152, 0, 0.12);
    border-radius: 3px;
}

/* ── Action bar ── */
.action-bar {
    background-color: #1F1F1F;
    border-top-width: 1px;
    border-top-color: #333333;
    flex-direction: row;
    height: 54px;
    align-items: center;
    padding-left: 16px;
    padding-right: 16px;
    flex-shrink: 0;
}

.action-hint {
    color: #777777;
    font-size: 12px;
}

.action-spacer {
    flex-grow: 1;
}

.ready-btn {
    color: #FFFFFF;
    font-size: 14px;
    -unity-font-style: bold;
    background-color: #2E7D32;
    border-width: 0px;
    border-radius: 4px;
    height: 36px;
    padding-left: 32px;
    padding-right: 32px;
    flex-shrink: 0;
}

.ready-btn:hover {
    background-color: #388E3C;
}

.ready-btn:active {
    background-color: #1B5E20;
}

.cancel-btn {
    color: #FFFFFF;
    font-size: 14px;
    -unity-font-style: bold;
    background-color: #E65100;
    border-width: 0px;
    border-radius: 4px;
    height: 36px;
    padding-left: 24px;
    padding-right: 24px;
    flex-shrink: 0;
    margin-left: 8px;
}

.cancel-btn:hover {
    background-color: #F57C00;
}

.cancel-btn:active {
    background-color: #BF360C;
}
